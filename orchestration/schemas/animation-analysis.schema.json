{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://video-agent.local/schemas/animation-analysis.schema.json",
  "title": "animation-analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "source_id",
    "source_url",
    "source_type",
    "analysis_status",
    "video_metadata",
    "scenes",
    "objects",
    "animations",
    "timestamps",
    "motion_parameters",
    "visual_style",
    "evidence",
    "confidence",
    "limitations",
    "rights_note",
    "lab_analysis_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "local",
        "youtube",
        "synthetic"
      ]
    },
    "analysis_status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "video_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "frame_count",
        "duration_seconds",
        "has_audio"
      ],
      "properties": {
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "frame_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "has_audio": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_frame",
          "end_frame",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "end_frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scene_id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object_id",
          "type",
          "start_seconds",
          "end_seconds",
          "basis",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "basis": {
            "enum": [
              "measured",
              "estimated",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "timestamps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frame",
          "seconds",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "basis": {
            "enum": [
              "measured",
              "estimated",
              "unknown"
            ]
          }
        }
      }
    },
    "motion_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "parameter",
          "value",
          "unit",
          "basis",
          "evidence_ids"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "measured",
              "estimated",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "frame",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frame": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rights_note": {
      "type": "string",
      "minLength": 1
    },
    "lab_analysis_path": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

  "prompt_rules": [
    {
      "id": "P-design",
      "pattern": "設計|アーキテクチャ|architecture|設計判断|方針を決",
      "task_type": "design",
      "difficulty": "L3"
    },
    {
      "id": "P-video",
      "pattern": "動画解析|参考動画|フレーム|video|映像の解析",
      "task_type": "video_analysis",
      "difficulty": "L2"
    },
    {
      "id": "P-animation",
      "pattern": "アニメーション|remotion|animation|モーション",
      "task_type": "animation",
      "difficulty": "L2"
    },
    {
      "id": "P-review",
      "pattern": "レビュー|review|監査|audit",
      "task_type": "review",
      "difficulty": "L2"
    },
    {
      "id": "P-impl",
      "pattern": "実装|implement|修正|fix|バグ|bug|テストを|refactor|リファクタ",
      "task_type": "implementation",
      "difficulty": "L2"
    },
    {
      "id": "P-summary",
      "pattern": "要約|summar|まとめて",
      "task_type": "summarization",
      "difficulty": "L1"
    },
    {
      "id": "P-extract",
      "pattern": "抽出|extract|一覧|列挙|list up|探して|find",
      "task_type": "extraction",
      "difficulty": "L1"
    },
    {
      "id": "P-classify",
      "pattern": "分類|classif|仕分け",
      "task_type": "classification",
      "difficulty": "L1"
    }
  ],
  "prompt_bumps": [
    {
      "id": "B-critical",
      "pattern": "本番|重大|セキュリティ|security|移行|migration|データ損失|課金|最高難度|critical",
      "delta": 1
    }
  ],
  "estimates_total_tokens": {
    "L1": 30000,
    "L2": 120000,
    "L3": 300000,
    "L4": 600000
  },
  "limits": {
    "max_retries": 2,
    "max_escalations": 1,
    "max_depth": 3,
    "approval_ttl_seconds": 900,
    "timeout_seconds": {
      "L0": 600,
      "L1": 600,
      "L2": 1800,
      "L3": 3600,
      "L4": 3600
    }
  },
  "escalation": {
    "escalate_on": [
      "capability",
      "quality"
    ],
    "retry_same_on": [
      "transient"
    ],
    "stop_on": [
      "auth",
      "budget",
      "policy",
      "input",
      "tooling",
      "model_mismatch",
      "unknown"
    ]
  },
  "auth": {
    "allow_api_billing": false,
    "api_billing_requires_human_approval": true
  },
  "native_subagents": {
    "enforce_model": true,
    "missing_model": "inject",
    "mismatch": "deny"
  },
  "metering": {
    "required_when_audit": true
  },
  "llm_classifier": {
    "enabled": false,
    "note": "判断が難しい場合だけ軽量モデルで分類する。既定は無効で、決められないときはL2・difficulty_source=defaultを記録する。"
  },
  "optimizer": {
    "min_samples_per_group": 20,
    "trigger_every_n_executions": 50,
    "min_pass_rate": 0.9,
    "max_pass_rate_drop": 0.1,
    "regression_min_samples": 10
  },
  "overrides": [
    {
      "task_type": "extraction",

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": ["tools/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "src/channel-value.ts"]
}

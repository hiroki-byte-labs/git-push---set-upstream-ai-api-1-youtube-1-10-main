{
  "name": "motion-lab",
  "version": "0.1.0",
  "description": "参考動画の動きの解析とRemotionでの再現・比較の最小検証環境（T110）",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "lab": "node tools/lab.ts",
    "reference": "node tools/make-reference.ts",
    "analyze": "node tools/analyze.ts",
    "compare": "node tools/compare.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint src && tsc -p tsconfig.json"
  }
}

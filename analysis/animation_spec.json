  "implementation_guidelines": {
    "remotion_code_structure": {
      "interpolation_pattern": "const progress = interpolate(frame, [startFrame, endFrame], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.33, 1, 0.68, 1) });",
      "recommended_spring": "useCurrentFrame() with spring({ frame, fps, config: { damping: 20, mass: 0.8, stiffness: 100 } }) as alternative to bezier for organic settling."
    },
    "verification_criteria": [
      "No sudden 1-frame pop-in without interpolation.",
      "Contrast ratio between #ffffff / #3b82f6 text and #0a0a0c background exceeds WCAG AAA (>= 7.0:1).",
      "No overlapping bounding boxes between headline text (Y=440), accent line (Y=495), and pictogram (Y=660)."

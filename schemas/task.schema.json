{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentctl.local/schemas/task.schema.json",
  "title": "task v1",
  "description": "Gatewayへ渡すタスク。プロンプト本文は持たず、prompt_fileのパスだけを持つ（本文はDBへ保存しない）。task_idがnullならGatewayが発行する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "parent_task_id", "title", "task_type", "difficulty", "quality_requirement", "initiator", "agent_name", "required_capabilities", "preferred_provider", "budget", "input", "expected_artifacts", "test_command", "audit"],
  "properties": {
    "schema_version": {"const": "1"},
    "task_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/task_id"}, {"type": "null"}]},
    "parent_task_id": {"$ref": "common.schema.json#/definitions/nullable_task_id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "task_type": {"$ref": "common.schema.json#/definitions/task_type"},
    "difficulty": {"oneOf": [{"$ref": "common.schema.json#/definitions/difficulty"}, {"type": "null"}]},
    "quality_requirement": {"$ref": "common.schema.json#/definitions/quality_requirement"},
    "initiator": {"$ref": "common.schema.json#/definitions/initiator"},
    "agent_name": {"type": ["string", "null"], "maxLength": 100},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["code", "analysis", "video", "image", "long_context", "tools"]}},
    "preferred_provider": {"oneOf": [{"$ref": "common.schema.json#/definitions/provider"}, {"type": "null"}]},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_usd", "max_total_tokens", "max_retries", "max_escalations"],
      "properties": {
        "max_usd": {"$ref": "common.schema.json#/definitions/nullable_number"},
        "max_total_tokens": {"$ref": "common.schema.json#/definitions/nullable_int"},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_escalations": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_file", "program", "workdir", "permission_profile"],
      "properties": {
        "prompt_file": {"type": ["string", "null"], "minLength": 1},
        "program": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["argv"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}]},
        "workdir": {"type": ["string", "null"], "minLength": 1},
        "permission_profile": {"enum": ["read_only", "workspace_write"]},
        "mock": {"type": "object", "description": "テスト専用。provider=mockの模擬動作。本番経路では無視する。"}
      }
    },
    "expected_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "test_command": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]},
    "audit": {"type": "boolean", "description": "trueなら計測（measured）がない実行を正常完了にしない。"}
  }
}

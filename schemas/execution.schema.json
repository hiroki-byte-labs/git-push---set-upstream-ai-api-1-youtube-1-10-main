{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentctl.local/schemas/execution.schema.json",
  "title": "execution v1",
  "description": "1回の実行の記録。製品をまたいで同じ形式。取得できない値はnull。statusのcompletedは処理の終了で、品質の合格はevaluationが表す。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "parent_task_id", "execution_id", "parent_execution_id", "decision_id", "initiator", "agent_name", "provider", "model_id", "reasoning_level", "task_type", "difficulty", "routing_reason", "status", "managed", "route", "auth_mode", "start_time", "end_time", "duration_ms", "retry_count", "escalation_count", "artifacts", "test_results", "metering_status", "session_ref", "error"],
  "properties": {
    "schema_version": {"const": "1"},
    "task_id": {"$ref": "common.schema.json#/definitions/task_id"},
    "parent_task_id": {"$ref": "common.schema.json#/definitions/nullable_task_id"},
    "execution_id": {"$ref": "common.schema.json#/definitions/execution_id"},
    "parent_execution_id": {"$ref": "common.schema.json#/definitions/nullable_execution_id"},
    "decision_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/decision_id"}, {"type": "null"}]},
    "initiator": {"$ref": "common.schema.json#/definitions/initiator"},
    "agent_name": {"type": ["string", "null"]},
    "provider": {"oneOf": [{"$ref": "common.schema.json#/definitions/provider"}, {"type": "null"}]},
    "model_id": {"type": ["string", "null"]},
    "reasoning_level": {"$ref": "common.schema.json#/definitions/reasoning_level"},
    "task_type": {"$ref": "common.schema.json#/definitions/task_type"},
    "difficulty": {"oneOf": [{"$ref": "common.schema.json#/definitions/difficulty"}, {"type": "null"}]},
    "routing_reason": {"type": ["string", "null"]},
    "status": {"$ref": "common.schema.json#/definitions/execution_status"},
    "managed": {"type": "boolean", "description": "Gatewayまたは承認つきHookを通った実行ならtrue。観測しただけの実行はfalse。"},
    "route": {"oneOf": [{"$ref": "common.schema.json#/definitions/route"}, {"type": "null"}]},
    "auth_mode": {"$ref": "common.schema.json#/definitions/auth_mode"},
    "start_time": {"$ref": "common.schema.json#/definitions/nullable_datetime"},
    "end_time": {"$ref": "common.schema.json#/definitions/nullable_datetime"},
    "duration_ms": {"$ref": "common.schema.json#/definitions/nullable_int"},
    "retry_count": {"type": "integer", "minimum": 0},
    "escalation_count": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "exists", "sha256"], "properties": {"path": {"type": "string"}, "exists": {"type": "boolean"}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}}},
    "test_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "detail"], "properties": {"name": {"type": "string"}, "status": {"enum": ["passed", "failed", "skipped", "not_run"]}, "detail": {"type": ["string", "null"]}}}},
    "metering_status": {"$ref": "common.schema.json#/definitions/metering_status"},
    "session_ref": {"type": "object", "additionalProperties": false, "required": ["product", "session_id", "agent_id"], "properties": {"product": {"type": ["string", "null"]}, "session_id": {"type": ["string", "null"]}, "agent_id": {"type": ["string", "null"]}}},
    "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["cause", "message"], "properties": {"cause": {"$ref": "common.schema.json#/definitions/failure_cause"}, "message": {"type": "string"}}}]}
  }
}
